#!/bin/sh
# Refuses a commit that stages a credentials file or a value that looks like a key.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
bad=$(echo "$staged" | grep -E '(^|/)(federal\.env|credentials|[^/]*\.(pem|key))$|(^|/)\.cdp/' | grep -v 'federal\.env\.example$')
if [ -n "$bad" ]; then
  echo "pre-commit: credentials file staged; commit refused:" >&2
  echo "$bad" >&2
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' | grep -qE \
  '(CDP_PRIVATE_KEY|CDP_ACCESS_KEY_ID|cdp_private_key|cdp_access_key_id)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9+/_-]{8,}|BEGIN [A-Z ]*PRIVATE KEY'; then
  echo "pre-commit: a staged line looks like a CDP key or private key; commit refused" >&2
  exit 1
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner || { echo "pre-commit: gitleaks found a secret; commit refused" >&2; exit 1; }
fi
exit 0
