# Copy to ~/.config/federal-cdp/federal.env (or ./federal.env, gitignored). Placeholders only.
# On a Cursor cloud agent, add each name as a secret instead (Dashboard > Cloud Agents > Secrets).
# fedops loads the first file it finds: $FEDERAL_ENV_FILE, ~/.config/federal-cdp/federal.env, ./federal.env.
# Variables already set in the environment win over the file.

# CDP API access key of a user with EnvironmentAdmin on the federal environment
CDP_ACCESS_KEY_ID=
CDP_PRIVATE_KEY=

# Control plane: leave empty for the default us-west-1; set for another region or a dedicated endpoint
CDP_REGION=
CDP_ENDPOINT_URL=

# Optional: path to the cdp executable when it is not .venv/bin/cdp or on PATH
FEDERAL_CDP_CLI=
