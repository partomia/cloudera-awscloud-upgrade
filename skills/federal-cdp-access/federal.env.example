# Federal CDP environment (federal-cdp-env): one file for every project and the Cursor agent.
# Real copy: ~/.config/federal-cdp/federal.env (mode 600, never in a repo). Load it with
#   set -a; source ~/.config/federal-cdp/federal.env; set +a
# Never print, log or commit a value of a *_PASSWORD, *_KEY or *_TOKEN variable.

# ---------------------------------------------------------------- control plane (CDP CLI / API)
# The CDP CLI reads its access key from ~/.cdp/credentials (profile below); not copied here.
FEDERAL_CDP_PROFILE=default
FEDERAL_CDP_CLI=~/.local/bin/cdp
FEDERAL_CDP_ENDPOINT=https://console.us-west-1.cdp.cloudera.com
FEDERAL_CDP_CONTROL_PLANE_REGION=us-west-1
FEDERAL_ENV_NAME=federal-cdp-env
FEDERAL_ENV_CRN=crn:cdp:environments:us-west-1:d1a4553c-a799-432d-8e54-372cc2ab95f2:environment:80343f15-b78e-4e57-88fb-80e531da17e5
FEDERAL_CLOUD=AWS
FEDERAL_AWS_REGION=ap-south-1
FEDERAL_CLOUD_CREDENTIAL=federal-xaccount-cred
FEDERAL_DOMAIN=federal.dp5i-5vkq.cloudera.site
FEDERAL_BUCKET=s3a://federal-buk-574bcea0
FEDERAL_WAREHOUSE_ROOT=s3a://federal-buk-574bcea0/data/warehouse/tablespace/external/hive

# ---------------------------------------------------------------- workload identity (FreeIPA user)
# Same user and password for Impala (LDAP), Kafka (SASL PLAIN), Knox, IDBroker, NiFi, Hue.
FEDERAL_WORKLOAD_USER=
FEDERAL_WORKLOAD_PASSWORD=

# ---------------------------------------------------------------- Data Lake
FEDERAL_DATALAKE=federal-aw-dl
FEDERAL_DATALAKE_CRN=crn:cdp:datalake:us-west-1:d1a4553c-a799-432d-8e54-372cc2ab95f2:datalake:f9268689-64e6-48d7-90ad-b52c34bfe51c
FEDERAL_DATALAKE_API=https://federal-aw-dl-gateway.federal.dp5i-5vkq.cloudera.site/federal-aw-dl/cdp-proxy-api
FEDERAL_HMS_URI=thrift://federal-aw-dl-master0.federal.dp5i-5vkq.cloudera.site:9083
FEDERAL_IDBROKER_TOKEN_URL=https://federal-aw-dl-idbroker0.federal.dp5i-5vkq.cloudera.site:8444/gateway/dt/knoxtoken/api/v1/token?knox.token.client.cert.required=false
FEDERAL_IDBROKER_CAB_URL=https://federal-aw-dl-idbroker0.federal.dp5i-5vkq.cloudera.site:8444/gateway/aws-cab/cab/api/v1/credentials
FEDERAL_CA_PEM=~/.ogx/federal-cdp-env-ca.pem

# ---------------------------------------------------------------- CDW (cluster env-jjwgzn)
FEDERAL_CDW_CLUSTER_ID=env-jjwgzn
FEDERAL_CDW_DBC=warehouse-1786368977-gcqp
FEDERAL_IMPALA_VW=federal-impala-1
FEDERAL_IMPALA_VW_ID=impala-1795670345-2pbx
FEDERAL_IMPALA_HOST=coordinator-federal-impala-1.dw-federal-cdp-env.dp5i-5vkq.cloudera.site
FEDERAL_IMPALA_PORT=443
FEDERAL_IMPALA_HTTP_PATH=cliservice
FEDERAL_IMPALA_AUTH=LDAP
FEDERAL_HIVE_VW_ID=compute-1795671915-kvqz
FEDERAL_TRINO_VW_ID=trino-1795671924-kqnz
FEDERAL_DATAVIZ_IDS=viz-1786369361-cwrg,viz-1790708419-p74l

# ---------------------------------------------------------------- CAI (Cloudera AI workbench)
FEDERAL_CAI_WORKSPACE=federal-cml-ws
FEDERAL_CAI_HOST=https://federal-cml.federal.dp5i-5vkq.cloudera.site
# API v2 key (User settings > API keys), not a Model API key
FEDERAL_CAI_API_KEY=

# ---------------------------------------------------------------- CDE (service federal-cde)
# The cde CLI reads ~/.cde/config.yaml (user, vcluster endpoint, auth-pass-file); not copied here.
FEDERAL_CDE_SERVICE=federal-cde
FEDERAL_CDE_CLUSTER_ID=cluster-lzjl69mv
FEDERAL_CDE_VC=federal-cde-vc
FEDERAL_CDE_VC_ID=dex-app-bxjjm2cr
FEDERAL_CDE_VCLUSTER_ENDPOINT=https://bxjjm2cr.cde-lzjl69mv.federal.dp5i-5vkq.cloudera.site/dex/api/v1

# ---------------------------------------------------------------- Data Hubs (7.3.2)
FEDERAL_DATAHUB_KAFKA=federal-kafka
FEDERAL_DATAHUB_NIFI=federal-nifi
FEDERAL_DATAHUB_FLINK=federal-flink
FEDERAL_KAFKA_BOOTSTRAP=federal-kafka-corebroker0.federal.dp5i-5vkq.cloudera.site:9093,federal-kafka-corebroker1.federal.dp5i-5vkq.cloudera.site:9093,federal-kafka-corebroker2.federal.dp5i-5vkq.cloudera.site:9093
FEDERAL_KAFKA_SECURITY_PROTOCOL=SASL_SSL
FEDERAL_KAFKA_SASL_MECHANISM=PLAIN
FEDERAL_SCHEMA_REGISTRY_URL=https://federal-kafka-master0.federal.dp5i-5vkq.cloudera.site/federal-kafka/cdp-proxy-api/schema-registry/api/v1
FEDERAL_SMM_API_URL=https://federal-kafka-master0.federal.dp5i-5vkq.cloudera.site/federal-kafka/cdp-proxy-api/smm-api
